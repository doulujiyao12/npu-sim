msgid "**type : string**"
msgstr ""

#: ../../source/getting_started/workload_config_syntax.rst:292
msgid "原语类型（需填写指定字符串，见下）。"
msgstr ""

#: ../../source/getting_started/workload_config_syntax.rst:294
msgid "**{{var}} : string/number**"
msgstr ""

